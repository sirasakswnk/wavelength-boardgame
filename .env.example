# ── Firebase config ──────────────────────────────────────────────
# 1) คัดลอกไฟล์นี้เป็น .env  (คำสั่ง: cp .env.example .env)
# 2) เอาค่าจริงจาก Firebase Console → ⚙️ Project settings → "Your apps" → SDK setup and configuration
# 3) รีสตาร์ท dev server หลังแก้ .env
# (.env ถูก gitignore ไว้แล้ว จะไม่ถูก commit)

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.asia-southeast1.firebasedatabase.app
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=
