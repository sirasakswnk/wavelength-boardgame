{
  "rules": {
    "rooms": {
      "$code": {
        "meta": {
          ".read": "auth != null",
          ".write": "auth != null"
        },
        "players": {
          ".read": "auth != null",
          ".write": "auth != null"
        },
        "public": {
          ".read": "auth != null",
          ".write": "auth != null"
        },
        "presence": {
          ".read": "auth != null",
          ".write": "auth != null"
        },
        "secret": {
          ".read": "auth != null && auth.uid === root.child('rooms').child($code).child('public').child('psychicUid').val()",
          ".write": "auth != null"
        }
      }
    }
  }
}
